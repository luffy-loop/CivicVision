APP_NAME=CivicVision API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./civicvision.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,https://civicvision-ai-mocha.vercel.app
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8
MODEL_PATH=
MODEL_VERSION=unversioned
DEMO_MODE=true
DUPLICATE_RADIUS_KM=0.15
DUPLICATE_WINDOW_DAYS=90
MAX_IMAGE_PIXELS=25000000
# Configure individual authority accounts using password hashes created by scripts/create_authority_hash.py.
AUTHORITY_USERS=[]
# Generate a unique, random secret of at least 32 bytes. Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_MINUTES=480
# Development may run pending migrations on startup. Set false in production and run `alembic upgrade head` as a release step.
AUTO_MIGRATE=true
