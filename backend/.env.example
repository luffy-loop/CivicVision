APP_NAME=CivicVision API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./civicvision.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8
MODEL_PATH=
MODEL_VERSION=unversioned
DEMO_MODE=true
DUPLICATE_RADIUS_KM=0.15
DUPLICATE_WINDOW_DAYS=90
MAX_IMAGE_PIXELS=25000000
# Reviewer status updates return 503 until a secret is configured. Use a unique random value.
REVIEWER_API_KEY=
